# Copy to .env.local and set the backend URL.
# Empty / unset -> the app runs on local mock data (localStorage), no login.
# Set -> real service: login, teams, project list, task read/comment/delete use the backend;
#        features without a backend API yet (project/task create and edit, meetings,
#        notifications, GitHub) show "준비 중" (see src/services/features.ts).
#
# On Vercel: Project Settings > Environment Variables > VITE_API_BASE_URL=https://<backend>
# (a release build refuses a plain-http remote API).
VITE_API_BASE_URL=
